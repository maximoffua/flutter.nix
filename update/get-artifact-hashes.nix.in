{ callPackage
, flutter
, lib
, symlinkJoin
,
}:
let
  flakeRoot = "@flake_root@";

  flutterPlatforms = [
    "android"
    "ios"
    "web"
    "linux"
    "windows"
    "macos"
    "fuchsia"
    "universal"
  ];
  systemPlatforms = [
    "x86_64-linux"
    "aarch64-linux"
    "x86_64-darwin"
    "aarch64-darwin"
  ];

  derivations =
    lib.foldl'
      (
        acc: flutterPlatform:
          acc
          ++ (map
            (systemPlatform:
              callPackage "${flakeRoot}/packages/flutter/artifacts/fetch-artifacts.nix" {
                inherit flutter;
                inherit flutterPlatform;
                inherit systemPlatform;
                hash = lib.fakeSha256;
              })
            systemPlatforms)
      ) [ ]
      flutterPlatforms;
in
symlinkJoin {
  name = "evaluate-derivations";
  paths = derivations;
}

